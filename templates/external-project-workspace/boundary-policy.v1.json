{
  "schema": "mnstry.atelier-boundary-policy@v1",
  "mode": "strict",
  "actors": {
    "sample-author": {
      "githubLogin": "sample-author",
      "gitEmails": [
        "sample@example.invalid"
      ],
      "privateDomainRepo": "source"
    }
  },
  "repos": {
    "source": {
      "kind": "private_domain",
      "ownerActor": "sample-author",
      "readBoundary": "private",
      "allowedAudiences": [
        "private"
      ],
      "forbiddenAudiences": [
        "public"
      ],
      "autoCommit": "guarded"
    }
  },
  "forbiddenPaths": [
    ".atelier-local/**",
    "atelier.local.json",
    "atelier.workspace.local.json",
    ".mnstry-local/**",
    ".atelier-proposals/**",
    ".atelier-current",
    ".atelier-current.json",
    ".atelier-presence.json",
    ".atelier-nonce",
    ".atelier-capability-grants.json",
    ".atelier-grants/**",
    ".atelier-events.jsonl",
    ".atelier-audit.jsonl",
    ".atelier-audit/**",
    ".atelier-session.json",
    ".atelier-session.jsonl",
    ".atelier-session/**",
    ".atelier-sessions/**",
    ".atelier-support/**",
    ".atelier-support.json",
    "support-bundle*",
    "support-bundles/**",
    "prompts/**",
    "transcripts/**",
    "node_modules/**",
    ".DS_Store"
  ],
  "promotion": {
    "requiresGitPromote": true,
    "recordsPath": "governance/git-promote-events.jsonl"
  },
  "governanceLedgerPath": "governance/repo-boundary-ledger.md"
}
