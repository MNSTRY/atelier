{
  "schema": "mnstry.atelier-project-config@v1",
  "name": "sample-adapter",
  "roots": {
    "workspace": ".",
    "repoOps": "."
  },
  "graph": {
    "repoAccessPath": "repo-access.v1.json",
    "outputPath": "atelier-output/knowledge.graph.json"
  },
  "projection": {
    "outputRoot": "atelier-output",
    "readinessPath": "atelier-output/atelier-readiness.json"
  },
  "boundaries": {
    "policyPath": "boundary-policy.v1.json",
    "strictNewRepos": true
  },
  "repos": [
    {
      "name": "source",
      "path": "source",
      "readBoundary": "private"
    }
  ],
  "ext": {
    "mnstry.atelier": {
      "extensionPacks": [
        {
          "id": "sample.readiness",
          "version": "v1",
          "path": "packs/sample-pack.v1.json",
          "enabled": true
        }
      ],
      "extensionPackLifecycle": "pack-lifecycle.json"
    }
  }
}
