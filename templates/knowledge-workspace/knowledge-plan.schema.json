{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier knowledge setup plan",
  "description": "An editable, local planning format. Declarations do not grant authority or prove semantic correctness.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "atelier-knowledge-plan@v1"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "steward": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "review": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "correction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "required": [
        "admission",
        "review",
        "correction",
        "expression"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxContextBytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 262144
        },
        "maxSourceBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "maxDocuments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "maxContextBytes",
        "maxSourceBytes",
        "maxDocuments"
      ]
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "identityRule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "tag": {
            "type": "string",
            "pattern": "^concept:[a-z][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "id",
          "definition",
          "identityRule",
          "tag"
        ]
      }
    },
    "relations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "predicate": {
            "enum": [
              "related",
              "supports",
              "supersedes",
              "implements",
              "depends_on",
              "evidences",
              "contradicts",
              "belongs_to"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "predicate",
          "from",
          "to",
          "meaning"
        ]
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "work": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "concepts": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "relations": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "expect": {
            "enum": [
              "evidence",
              "abstain"
            ]
          },
          "expectedEvidence": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "sha256"
              ]
            }
          }
        },
        "required": [
          "id",
          "question",
          "work",
          "concepts",
          "relations",
          "expect",
          "expectedEvidence"
        ]
      }
    }
  },
  "required": [
    "schema",
    "purpose",
    "steward",
    "reviewer",
    "governance",
    "budget",
    "concepts",
    "relations",
    "questions"
  ]
}
