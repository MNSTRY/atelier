{
  "schema": "atelier-obsidian-ext-settings/v1",
  "enabled": true,
  "defaultScopeId": "scope-full",
  "scopes": [
    {
      "scopeId": "scope-full",
      "mode": "full",
      "selector": {
        "all": true
      }
    },
    {
      "scopeId": "scope-topic",
      "mode": "scoped",
      "selector": {
        "repo": "north",
        "pathPrefix": "/srv/example/north/"
      },
      "expansion": {
        "depth": 1,
        "maxNodes": 3,
        "direction": "outgoing",
        "order": "canonical-id"
      }
    }
  ]
}
