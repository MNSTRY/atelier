        "title": "Invented source reconsideration",
        "term": "material",
        "body": "{\n  \"format\": \"atelier.decision-practice/v0\",\n  \"id\": \"reading-room-reconsideration\",\n  \"revision\": \"one\",\n  \"purpose\": \"Prepare a draft for a person when changed source material affects an earlier reading-room decision.\",\n  \"applicability\": \"Invented reading-room material only. Changes are reviewed, never applied automatically.\",\n  \"rightsBasis\": \"Wholly invented conformance material.\",\n  \"evidenceRoles\": [\n    \"source\",\n    \"decision\"\n  ],\n  \"prerequisites\": [\n    \"source-changed\"\n  ],\n  \"rubric\": {\n    \"schema\": \"atelier-decision-request@v1\",\n    \"contractVersion\": \"1.0.0\",\n    \"id\": \"synthetic-request-1\",\n    \"task\": \"passage-triage\",\n    \"rubricVersion\": \"fictional-notes.v1\",\n    \"scope\": {\n      \"workspaceId\": \"synthetic-workspace\",\n      \"authorizationRef\": \"synthetic-consent-1\"\n    },\n    \"state\": \"passage-1: The fictional Cedarbell reading room opens on Saturday. Its blue shelf needs a new bracket.\\npassage-2: This note does not describe Sunday hours.\",\n    \"evidence\": [\n      {\n        \"id\": \"passage-1\",\n        \"sourceRef\": \"fictional-notes:passage-1\"\n      },\n      {\n        \"id\": \"passage-2\",\n        \"sourceRef\": \"fictional-notes:passage-2\"\n      }\n    ],\n    \"questions\": {\n      \"priority\": {\n        \"type\": \"choice\",\n        \"instructions\": \"Which reading-room note should a person inspect next? Keep all source passages regardless of the answer.\",\n        \"evidenceIds\": [\n          \"passage-1\",\n          \"passage-2\"\n        ],\n        \"criteria\": {\n          \"maintenance\": \"A passage describes a repair to inspect.\",\n          \"hours\": \"A passage only describes opening hours.\",\n          \"unmatched\": \"Neither description fits.\"\n        }\n      },\n      \"evidence_score\": {\n        \"type\": \"score\",\n        \"instructions\": \"How directly does passage-1 support the statement that the blue shelf needs repair?\",\n        \"evidenceIds\": [\n          \"passage-1\"\n        ],\n        \"criteria\": [\n          \"No support.\",\n          \"Indirect support.\",\n          \"Direct support.\"\n        ]\n      },\n      \"saturday_open\": {\n        \"type\": \"boolean\",\n        \"instructions\": \"Does passage-1 state that the fictional reading room opens on Saturday?\",\n        \"evidenceIds\": [\n          \"passage-1\"\n        ],\n        \"criteria\": {\n          \"true\": \"The passage explicitly says it opens on Saturday.\",\n          \"false\": \"The passage does not say it opens on Saturday.\"\n        }\n      }\n    }\n  },\n  \"limits\": {\n    \"stages\": 3,\n    \"evidence\": 4,\n    \"assessments\": 1,\n    \"proposals\": 1\n  },\n  \"allowedProposals\": [\n    \"reconsideration\"\n  ],\n  \"outcomeMap\": {\n    \"question\": \"priority\",\n    \"choices\": {\n      \"maintenance\": \"proceed\",\n      \"hours\": \"stop\",\n      \"unmatched\": \"escalate\"\n    }\n  }\n}",
