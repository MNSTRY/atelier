    },
    {
      "id": "state",
      "primitive": "StatusView",
      "semanticRoleRefs": []
    }
  ],
  "runtimeProfileRef": null,
  "carriers": [
    {
      "id": "web",
      "required": true
    },
    {
      "id": "documents",
      "required": true
    },
    {
      "id": "chat",
      "required": false
    }
  ],
  "extensions": [],
  "optionalDecisions": [
    {
      "id": "reading-priority",
      "contract": "atelier-decision-request@v1",
      "required": false
    }
  ],
  "compatibility": {
    "atelierVersions": [
      "0.2.0-alpha.7",
      "0.2.0-alpha.8",
      "0.2.0-alpha.9",
      "0.2.0-alpha.10"
    ],
    "packRefs": []
  },
  "definitionLicense": "Apache-2.0"
