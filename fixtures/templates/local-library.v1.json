{
  "schema": "atelier-template-profile@v1",
  "id": "sample.library",
  "version": "1.0.0",
  "purpose": "Organize an invented local reading shelf.",
  "inputs": [
    "Project-owned text resources"
  ],
  "limitations": [
    "Runtime actions require a separately qualified host."
  ],
  "semanticRoles": [
    {
      "id": "items",
      "primitive": "Resource",
