# Pack qualification hashes committed bytes; prevent checkout conversion.
templates/external-project-workspace/packs/** text eol=lf
templates/knowledge-workspace/** text eol=lf

# Generated schema bytes must match the canonical LF generator on every host.
src/ui/presentation/schema.generated.mjs text eol=lf

# The evidence-navigation generator hashes the contract's raw bytes into its
# generation record; --check compares the generated schema, types and record byte
# for byte.
contracts/atelier-evidence-navigation.v1.schema.json text eol=lf
src/evidence-navigation/schema.generated.mjs text eol=lf
src/evidence-navigation/types.mjs text eol=lf
src/evidence-navigation/generation.mjs text eol=lf

# The ontology-profile example pins source and capture digests.
examples/knowledge-ontology-profile/** text eol=lf

# Sealed capability bundles and imported ADRs retain their pinned source bytes.
fixtures/capability-packages/** text eol=lf
fixtures/inquiry-packages/** text eol=lf
fixtures/harness-packages/** text eol=lf
fixtures/atelier-judgment/native-decision.md text eol=lf

# Atelier's Obsidian plugin is copied byte for byte into every managed vault and
# its version is pinned to its code digest: the same bytes on every host.
plugins/obsidian/** text eol=lf

# The Knowledge Health kit pins its owner rule files by digest and binds its
# findings to exact fixture bytes: the same bytes on every host.
src/knowledge/plan.mjs text eol=lf
src/knowledge/context.mjs text eol=lf
src/graph/graph.mjs text eol=lf
src/graph/knowledge-graph.mjs text eol=lf
fixtures/knowledge-health/** text eol=lf
