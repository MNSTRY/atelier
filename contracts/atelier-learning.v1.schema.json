        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved inert extension container; no extension members are interpreted in v1."
        }
      }
    },
    "proposeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "principle",
        "rationale",
        "exceptions",
        "evidenceIds",
        "scope",
        "artifact"
