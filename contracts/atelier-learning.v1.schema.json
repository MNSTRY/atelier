      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "exceptions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
