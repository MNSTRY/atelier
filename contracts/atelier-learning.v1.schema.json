            "maxLength": 2048
          }
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "supersedes": {
          "$ref": "#/$defs/id"
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved inert extension container; no extension members are interpreted in v1."
        }
      }
    },
    "decideInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "lessonDigest",
        "verdict",
