{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-learning.v1.schema.json",
  "title": "Portable local learning history v1",
  "description": "Locally asserted evidence and authority. Integrity digests are not identity authentication; source digests are external assertions. Check artifacts are inert. No import or executable installation authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/workspace"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "activity"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/id"
        },
        "activity": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "const": "*"
            }
          ]
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved inert extension container; no extension members are interpreted in v1."
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "tool"
          ]
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved inert extension container; no extension members are interpreted in v1."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved inert extension container; no extension members are interpreted in v1."
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "content"
      ],
      "properties": {
        "kind": {
          "enum": [
            "instruction",
            "skill",
            "principle",
            "check"
          ]
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved inert extension container; no extension members are interpreted in v1."
        }
      }
    },
    "captureInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "signal",
        "text",
        "interpretation",
        "scope",
        "source"
