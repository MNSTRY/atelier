{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-upgrade-plan.v3.schema.json",
  "$comment": "contract revision 3.0.0",
  "title": "mnstry.atelier-upgrade-plan@v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "digest",
    "operation",
    "workspace",
    "repositoryId",
    "configPath",
    "baseHead",
    "baseTree",
    "branch",
    "createdAt",
    "expiresAt",
    "policy",
    "policyDigest",
    "executorDigest",
    "gitDigest",
    "gitConfigDigest",
    "hooksDigest",
    "hooksPath",
    "readSet",
    "migration",
    "writes",
    "releaseEvidence",
    "dependencyInstallation",
    "mode",
    "recoveryCoverage",
    "message",
    "gitAuxDigest",
    "participant"
  ],
  "properties": {
    "schema": {
      "const": "mnstry.atelier-upgrade-plan@v3"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "operation": {
      "const": "prepare-local-candidate"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "configPath": {
      "type": "string",
      "minLength": 1
    },
    "baseHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "baseTree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://mnstry.ai/schemas/atelier/atelier-adoption-policy.v2.schema.json",
      "$comment": "contract revision 2.0.0",
      "title": "mnstry.atelier-adoption-policy@v2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "enabled",
        "mode",
        "maxAgeSeconds",
        "recoveryCoverage",
        "allowedEffects",
        "participant"
      ],
      "properties": {
        "schema": {
          "const": "mnstry.atelier-adoption-policy@v2"
        },
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "const": "manual-exact-plan"
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "recoveryCoverage": {
          "const": "local-only"
        },
        "allowedEffects": {
          "const": [
            "template-adoption",
            "lock-and-projections",
            "git-commit"
          ]
        },
        "participant": {
          "const": "local-template-profile@1"
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved extension container; no extension behavior is supported by this contract."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^2\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "executorDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitConfigDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "hooksDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "hooksPath": {
      "type": "string",
      "minLength": 1
    },
    "readSet": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "state"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "digest",
                  "mode"
                ],
                "properties": {
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "ext": {
                    "type": "object",
                    "maxProperties": 0,
                    "description": "Reserved extension container; no extension behavior is supported by this contract."
                  }
                }
              }
            ]
          },
          "ext": {
            "type": "object",
            "maxProperties": 0,
            "description": "Reserved extension container; no extension behavior is supported by this contract."
          }
        }
      }
    },
    "migration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://mnstry.ai/schemas/atelier/atelier-migration.v3.schema.json",
      "$comment": "contract revision 3.0.0",
      "title": "mnstry.atelier-migration@v3",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "executorDigest",
        "readScope",
        "allowedWrites",
        "sideEffects",
        "postChecks"
      ],
      "properties": {
        "schema": {
          "const": "mnstry.atelier-migration@v3"
        },
        "id": {
          "const": "local-template-profile@1"
        },
        "executorDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "readScope": {
          "const": "whole-enrolled-repository"
        },
        "allowedWrites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sideEffects": {
          "const": [
            "git-index",
            "git-commit"
          ]
        },
        "postChecks": {
          "const": [
            "exact-inventory",
            "lock-schema",
            "exact-index",
            "commit-parent-tree-message",
            "template-adoption",
            "template-current-source"
          ]
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved extension container; no extension behavior is supported by this contract."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^3\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "owner",
          "action",
          "before",
          "after",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "enum": [
              "lock",
              "generated",
              "template",
              "template-history"
            ]
          },
          "action": {
            "enum": [
              "create",
              "update"
            ]
          },
          "before": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "digest",
                  "mode"
                ],
                "properties": {
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "ext": {
                    "type": "object",
                    "maxProperties": 0,
                    "description": "Reserved extension container; no extension behavior is supported by this contract."
                  }
                }
              }
            ]
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "digest",
              "mode"
            ],
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "mode": {
                "const": "100644"
              },
              "ext": {
                "type": "object",
                "maxProperties": 0,
                "description": "Reserved extension container; no extension behavior is supported by this contract."
              }
            }
          },
          "content": {
            "type": "string",
            "maxLength": 16777216
          },
          "ext": {
            "type": "object",
            "maxProperties": 0,
            "description": "Reserved extension container; no extension behavior is supported by this contract."
          }
        }
      }
    },
    "releaseEvidence": {
      "type": "null"
    },
    "dependencyInstallation": {
      "const": "excluded"
    },
    "mode": {
      "const": "manual-exact-plan"
    },
    "recoveryCoverage": {
      "const": "local-only"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "gitAuxDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profileFile",
        "selectionFile",
        "profileDigest",
        "selectionDigest",
        "templateRef",
        "bindingRef",
        "previousAdoptionDigest",
        "adoptionDigest"
      ],
      "properties": {
        "id": {
          "const": "local-template-profile@1"
        },
        "profileFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "selectionFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "selectionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "templateRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "TemplateRef"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "ext": {
              "type": "object",
              "maxProperties": 0,
              "description": "Reserved extension container; no extension behavior is supported by this contract."
            }
          }
        },
        "bindingRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "BindingRef"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "ext": {
              "type": "object",
              "maxProperties": 0,
              "description": "Reserved extension container; no extension behavior is supported by this contract."
            }
          }
        },
        "previousAdoptionDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          ]
        },
        "adoptionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "ext": {
          "type": "object",
          "maxProperties": 0,
          "description": "Reserved extension container; no extension behavior is supported by this contract."
        }
      }
    },
    "ext": {
      "type": "object",
      "maxProperties": 0,
      "description": "Reserved extension container; no extension behavior is supported by this contract."
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+$"
    }
  }
}
