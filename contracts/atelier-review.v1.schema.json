{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-review.v1.schema.json",
  "title": "Local review artifacts v1",
  "description": "Separate evidence, contributions and inspection artifacts. Local asserted identity carries no authenticated approval or source write authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/bound"
    },
    {
      "$ref": "#/$defs/bundle"
    },
    {
      "$ref": "#/$defs/lifecycle"
    }
  ],
  "$defs": {
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "kind",
            "targetId",
            "expectedVersion",
            "reviewer",
            "rationale",
            "runId",
            "evidenceDigest",
            "decision"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
            },
            "kind": {
              "const": "decision"
            },
            "targetId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
            },
            "evidenceDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "decision": {
              "enum": [
                "accepted",
                "rejected",
                "revised"
              ]
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "ext": {
              "type": "object",
              "description": "Reserved extensions; no approval, source-write or execution authority."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "decision": {
                    "const": "revised"
                  }
                }
              },
              "then": {
                "required": [
                  "revision"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "kind",
            "targetId",
            "expectedVersion",
            "reviewer",
            "repo",
            "path",
            "documentDigest",
            "anchor",
            "responseType",
            "wording"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
            },
            "kind": {
              "const": "response"
            },
            "targetId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "documentDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "anchor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "responseType": {
              "enum": [
                "question",
                "correction",
                "discussion"
              ]
            },
            "wording": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "ext": {
              "type": "object",
              "description": "Reserved extensions; no approval, source-write or execution authority."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "kind",
            "targetId",
            "expectedVersion",
            "reviewer",
            "repo",
            "path",
            "documentDigest",
            "anchor",
            "position"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
            },
            "kind": {
              "const": "position"
            },
            "targetId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "documentDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "anchor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "ext": {
              "type": "object",
              "description": "Reserved extensions; no approval, source-write or execution authority."
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "input",
        "inputDigest",
        "key",
        "version",
        "identity",
        "recordedAt"
      ],
      "properties": {
        "schema": {
          "const": "atelier-contribution@v1"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "key": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000001
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "local-asserted"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "ext": {
              "type": "object",
              "description": "Reserved extensions; no approval, source-write or execution authority."
            }
          }
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ext": {
          "type": "object",
          "description": "Reserved extensions; no approval, source-write or execution authority."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocolId",
        "protocol",
        "protocolDigest",
        "answers",
        "answersDigest",
        "configDigest",
        "lifecycleDigest",
        "policyDigest",
        "packs",
        "evaluator",
        "sources",
        "claimEvidence",
        "limitations",
        "digest"
      ],
      "properties": {
        "schema": {
          "const": "atelier-review-evidence@v1"
        },
        "protocolId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "protocol": {
          "$ref": "https://mnstry.ai/schemas/atelier/atelier-readiness-protocol.v1.schema.json"
        },
        "protocolDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "answers": {
          "type": "object"
        },
        "answersDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "lifecycleDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "ext": {
                "type": "object",
                "description": "Reserved extensions; no approval, source-write or execution authority."
              }
            }
          },
          "maxItems": 100
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "ext": {
              "type": "object",
              "description": "Reserved extensions; no approval, source-write or execution authority."
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "repo",
              "path",
              "audience",
              "digest",
              "metadata"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "repo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "audience": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "metadata": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ext": {
                "type": "object",
                "description": "Reserved extensions; no approval, source-write or execution authority."
              }
            }
          },
          "maxItems": 256
        },
        "claimEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mappingId",
              "sourceFields",
              "answers",
              "evidenceField",
              "references",
              "resolved",
              "unresolved",
              "status"
            ],
            "properties": {
              "mappingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "sourceFields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 256
              },
              "answers": {
                "type": "object"
              },
              "evidenceField": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "maxItems": 256
              },
              "resolved": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "repo",
                    "path",
                    "digest",
                    "excerpt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "excerpt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "ext": {
                      "type": "object",
                      "description": "Reserved extensions; no approval, source-write or execution authority."
                    }
                  }
                },
                "maxItems": 256
              },
              "unresolved": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "maxItems": 256
              },
              "status": {
                "enum": [
                  "linked-source",
                  "unresolved",
                  "missing"
                ]
              },
              "ext": {
                "type": "object",
                "description": "Reserved extensions; no approval, source-write or execution authority."
              }
            }
          },
          "maxItems": 256
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "ext": {
          "type": "object",
          "description": "Reserved extensions; no approval, source-write or execution authority."
        }
      }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run",
        "runDigest",
        "snapshot"
      ],
      "properties": {
        "schema": {
          "const": "atelier-bound-run@v1"
        },
        "run": {
          "$ref": "https://mnstry.ai/schemas/atelier/atelier-readiness-run.v1.schema.json"
        },
        "runDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "snapshot": {
          "$ref": "#/$defs/evidence"
        },
        "ext": {
          "type": "object",
          "description": "Reserved extensions; no approval, source-write or execution authority."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "bundleRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run",
        "runDigest",
        "snapshot",
        "decisions"
      ],
      "properties": {
        "schema": {
          "const": "atelier-bound-run@v1"
        },
        "run": {
          "$ref": "https://mnstry.ai/schemas/atelier/atelier-readiness-run.v1.schema.json"
        },
        "runDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "snapshot": {
          "$ref": "#/$defs/evidence"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "maxItems": 2000
        },
        "ext": {
          "type": "object",
          "description": "Reserved extensions; no approval, source-write or execution authority."
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "purpose",
        "classification",
        "members",
        "responses",
        "digest"
      ],
      "properties": {
        "schema": {
          "const": "atelier-inspection-bundle@v1"
        },
        "purpose": {
          "const": "historical-inspection-only"
        },
        "classification": {
          "const": "owner-selected-private-review"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "bytes",
              "digest",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,159}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "value": {
                "$ref": "#/$defs/bundleRun"
              },
              "ext": {
                "type": "object",
                "description": "Reserved extensions; no approval, source-write or execution authority."
              }
            }
          },
          "maxItems": 20,
          "minItems": 1
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "maxItems": 2000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "ext": {
          "type": "object",
          "description": "Reserved extensions; no approval, source-write or execution authority."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "packs"
      ],
      "properties": {
        "schema": {
          "const": "atelier-pack-lifecycle@v1"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "digest",
              "compatibleRootVersions",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "version": {
                "type": "string",
                "pattern": "^v[0-9]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "compatibleRootVersions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "maxItems": 100,
                "minItems": 1,
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "active",
                  "deprecated",
                  "retired"
                ]
              },
              "replacement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "migrationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "ext": {
                "type": "object",
                "description": "Reserved extensions; no approval, source-write or execution authority."
              }
            }
          },
          "maxItems": 100
        },
        "ext": {
          "type": "object",
          "description": "Reserved extensions; no approval, source-write or execution authority."
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "legacyRun": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://mnstry.ai/schemas/atelier/atelier-readiness-run.v1.schema.json",
      "$comment": "contract revision 1.1.0 (contract-stability epoch)",
      "title": "MNSTRY Atelier Readiness Run v1",
      "description": "Local, ignored, claim-first result of a readiness protocol run. A run can create proposed claims and draft packets, but it never grants runtime mutation, import, telemetry, egress, send-path, direct browser-write, or canonical graph/front-matter authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "runId",
        "protocolId",
        "createdAt",
        "project",
        "answers",
        "status",
        "score",
        "blockers",
        "warnings",
        "claims",
        "safety"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "schema": {
          "const": "atelier-readiness-run@v1"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "runId": {
          "type": "string",
          "pattern": "^readiness-run-[a-f0-9]{24}$"
        },
        "protocolId": {
          "$ref": "#/$defs/protocolId"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "answers": {
          "type": "object"
        },
        "status": {
          "enum": [
            "missing",
            "draft",
            "review-needed",
            "ready",
            "blocked"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "blockers": {
          "$ref": "#/$defs/stringList"
        },
        "warnings": {
          "$ref": "#/$defs/stringList"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "safety": {
          "$ref": "#/$defs/safety"
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
        }
      },
      "$defs": {
        "protocolId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*:[a-z][a-z0-9._-]*$"
        },
        "stringList": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "claimId",
            "subject",
            "predicate",
            "object",
            "provider",
            "status",
            "promoted"
          ],
          "properties": {
            "schema": {
              "const": "atelier-claim@v1"
            },
            "claimId": {
              "type": "string",
              "pattern": "^claim:[a-z0-9][a-z0-9:-]*$"
            },
            "subject": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9:-]*$"
