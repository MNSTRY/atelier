{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-action-intent.v1.schema.json",
  "$comment": "contract revision 1.1.0 (contract-stability epoch)",
  "title": "atelier-action-intent@v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "appliesTo",
    "reads",
    "writes",
    "authority",
    "deniedWhen"
  ],
  "properties": {
    "schema": {
      "const": "atelier-action-intent@v1"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^atelier\\.action\\.[a-z0-9][a-z0-9.-]*$"
    },
    "kind": {
      "enum": [
        "copy.repoPath",
        "copy.absolutePath",
        "copy.agentPrompt",
        "copy.realmPath",
        "copy.repoFolder"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "entry",
              "realm"
            ]
          },
          "uniqueItems": true
        },
        "targetTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
        }
      }
    },
    "reads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "writes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "const": "clipboard"
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "runtimeMutation"
      ],
      "properties": {
        "label": {
          "const": "Copy only; no runtime mutation"
        },
        "runtimeMutation": {
          "const": false
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
        }
      }
    },
    "deniedWhen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "message"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "ext": {
            "type": "object",
            "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
          }
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
    }
  }
}
