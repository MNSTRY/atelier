{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/analysis-adapter.v1.schema.json",
  "$comment": "contract revision 1.1.0 (contract-stability epoch)",
  "title": "analysis-adapter@v1",
  "description": "Local-only optional Analysis adapter contract. The adapter may record opt-in posture and claim files, but it cannot install Analysis, execute Analysis, create a model-provider boundary, or mutate canonical Atelier state.",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider",
        "outputRoot",
        "claimContract",
        "harness",
        "canonicalMutation",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "analysis-adapter-manifest@v1"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "provider": {
          "const": "analysis"
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "outputRoot": {
          "description": "Repo-relative ignored local directory for Analysis adapter artifacts.",
          "type": "string",
          "pattern": "^\\.mnstry/atelier/analysis(/.*)?$"
        },
        "claimContract": {
          "const": "atelier-claim@v1"
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "hiddenModelProvider",
            "network",
            "analysisExecution"
          ],
          "properties": {
            "policy": {
              "const": "active-agentic-harness-only"
            },
            "hiddenModelProvider": {
              "const": false
            },
            "network": {
              "const": "none"
            },
            "analysisExecution": {
              "const": false
            },
            "ext": {
              "type": "object",
              "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
            }
          }
        },
        "canonicalMutation": {
          "const": false
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claimOnly",
            "frontMatterMutation",
            "graphRelationMutation",
            "publicExportFeed",
            "mcpFeed",
            "runtimeImport",
            "directCanonicalWrite"
          ],
          "properties": {
            "claimOnly": {
              "const": true
            },
            "frontMatterMutation": {
              "const": false
            },
            "graphRelationMutation": {
              "const": false
            },
            "publicExportFeed": {
              "const": false
            },
            "mcpFeed": {
              "const": false
            },
            "runtimeImport": {
              "const": false
            },
            "directCanonicalWrite": {
              "const": false
            },
            "ext": {
              "type": "object",
              "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
            }
          }
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container. Producers MAY add namespaced members (recommend vendor-prefixed keys). Consumers MUST ignore members they do not recognize. Contents are not validated at v1 and carry no authority over first-class fields."
        }
      }
    },
    "claimOutput": {
      "description": "Analysis adapter output is only a list of proposed atelier-claim@v1 claims.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "schema",
          "provider",
          "status",
          "promoted"
        ],
        "properties": {
          "schema": {
            "const": "atelier-claim@v1"
          },
          "provider": {
            "const": "analysis"
          },
          "status": {
            "const": "proposed"
          },
          "promoted": {
            "const": false
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "kg"
              ]
            },
            {
              "required": [
                "frontmatter"
              ]
            },
            {
              "required": [
                "frontMatter"
              ]
            },
            {
              "required": [
                "canonicalFrontMatter"
              ]
            },
            {
              "required": [
                "relations"
              ]
            },
            {
              "required": [
                "graphRelations"
              ]
            },
            {
              "required": [
                "canonicalRelations"
              ]
            },
            {
              "required": [
                "edges"
              ]
            },
            {
              "required": [
                "publicExport"
              ]
            },
            {
              "required": [
                "atelierExport"
              ]
            },
            {
              "required": [
                "mcpFeed"
              ]
            },
            {
              "required": [
                "mcpResources"
              ]
            },
            {
              "required": [
                "runtimeImport"
              ]
            },
            {
              "required": [
                "importPlan"
              ]
            },
            {
              "required": [
                "canonicalWrite"
              ]
            },
            {
              "required": [
                "canonicalMutation"
              ]
            },
            {
              "required": [
                "mutation"
              ]
            },
            {
              "required": [
                "mutations"
              ]
            },
            {
              "required": [
                "writes"
              ]
            }
          ]
        }
      }
    }
  }
}
