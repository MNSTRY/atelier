{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-decision-result.v1.schema.json",
  "$comment": "contract revision 1.0.0; shape validation only. Use the pure validator for request binding, bounded JSON, evidence references and probability semantics.",
  "title": "Atelier proposal-only decision result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "requestDigest",
    "task",
    "rubricVersion",
    "scope",
    "provider",
    "authority",
    "mode",
    "status",
    "answers",
    "usage",
    "elapsedMs"
  ],
  "properties": {
    "schema": {
      "const": "atelier-decision-result@v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "rubricVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "ext": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      }
    },
    "authority": {
      "const": "proposal-only"
    },
    "mode": {
      "enum": [
        "shadow",
        "advisory"
      ]
    },
    "status": {
      "enum": [
        "assessed",
        "abstained"
      ]
    },
    "answers": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/choice"
          },
          {
            "$ref": "#/$defs/score"
          },
          {
            "$ref": "#/$defs/boolean"
          }
        ]
      }
    },
    "usage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/usage"
        }
      ]
    },
    "elapsedMs": {
      "type": "number",
      "minimum": 0
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "reason": {
      "enum": [
        "insufficient-evidence",
        "ambiguous",
        "no-match",
        "budget-exhausted",
        "provider-unavailable",
        "timeout",
        "invalid-response",
        "unauthorized"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "assessed"
        },
        "answers": {
          "minProperties": 1
        }
      },
      "not": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "abstained"
        },
        "answers": {
          "maxProperties": 0
        }
      },
      "required": [
        "reason"
      ]
    }
  ],
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "authorizationRef"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "authorizationRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "ext": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ext": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "choice",
        "probabilities",
        "confidence"
      ],
      "properties": {
        "type": {
          "const": "choice"
        },
        "choice": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "probabilities": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ext": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "score",
        "probabilities",
        "confidence"
      ],
      "properties": {
        "type": {
          "const": "score"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 9
        },
        "probabilities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ext": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      }
    },
    "boolean": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "probability"
      ],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ext": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      }
    }
  }
}
