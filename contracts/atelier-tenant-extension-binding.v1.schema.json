{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-tenant-extension-binding.v1.schema.json",
  "$comment": "contract revision 1.0.0",
  "title": "atelier-tenant-extension-binding@v1",
  "description": "A display-safe binding between one tenant, one declared Atelier extension pack, and one consumer-owned authoring projection. The binding grants no publication, editorial-gate, or MNSTRY runtime mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tenantRef",
    "extensionPack",
    "projection",
    "capabilities",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "atelier-tenant-extension-binding@v1"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "$ref": "#/$defs/stableRef"
    },
    "tenantRef": {
      "$ref": "#/$defs/stableRef"
    },
    "extensionPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container."
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "projectionId",
        "surfaceRef"
      ],
      "properties": {
        "schema": {
          "const": "atelier-authoring-projection@v1"
        },
        "projectionId": {
          "$ref": "#/$defs/stableRef"
        },
        "surfaceRef": {
          "$ref": "#/$defs/stableRef"
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localAuthoringState",
        "publicationMutation",
        "editorialGateMutation",
        "runtimeMutation"
      ],
      "properties": {
        "localAuthoringState": {
          "const": "consumer-owned"
        },
        "publicationMutation": {
          "const": false
        },
        "editorialGateMutation": {
          "const": false
        },
        "runtimeMutation": {
          "const": false
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container."
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Reserved extension container. Tenant-specific fields and private payload shapes belong here and remain governed by the consumer adapter."
    }
  },
  "$defs": {
    "stableRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    }
  }
}
