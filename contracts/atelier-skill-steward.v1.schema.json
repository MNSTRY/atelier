{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-skill-steward.v1.schema.json",
  "$comment": "contract revision 1.0.0 (contract-stability epoch)",
  "title": "MNSTRY Atelier Skill Steward v1",
  "description": "Portable contracts for skill-catalog audits, privacy-preserving improvement candidates, content-bound projection plans, and installed projection locks.",
  "oneOf": [
    {
      "$ref": "#/$defs/auditReport"
    },
    {
      "$ref": "#/$defs/candidateReport"
    },
    {
      "$ref": "#/$defs/syncPlan"
    },
    {
      "$ref": "#/$defs/syncLock"
    }
  ],
  "$defs": {
    "auditReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generatedAt",
        "ok",
        "surfaces",
        "summary",
        "entries",
        "findings",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "mnstry.atelier-skill-audit@v1"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ok": {
          "type": "boolean"
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "summary": {
          "$ref": "#/$defs/auditSummary"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillEntry"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "authority": {
          "$ref": "#/$defs/reportAuthority"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "candidateReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generatedAt",
        "ok",
        "candidates",
        "observationCount",
        "diagnostics",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "mnstry.atelier-skill-candidates@v1"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ok": {
          "const": true
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "observationCount": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "$ref": "#/$defs/reportAuthority"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "syncPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generatedAt",
        "planDigest",
        "applyAllowed",
        "source",
        "target",
        "actions",
        "blockers",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "mnstry.atelier-skill-sync-plan@v1"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "planDigest": {
          "$ref": "#/$defs/digest"
        },
        "applyAllowed": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/syncSource"
        },
        "target": {
          "$ref": "#/$defs/syncTarget"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncAction"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority": {
          "$ref": "#/$defs/syncAuthority"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "syncLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generatedAt",
        "source",
        "target",
        "skills",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "mnstry.atelier-skill-sync-lock@v1"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/syncSource"
        },
        "target": {
          "$ref": "#/$defs/relativePath"
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedSkill"
          }
        },
        "authority": {
          "$ref": "#/$defs/syncAuthority"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "auditSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skills",
        "errors",
        "warnings"
      ],
      "properties": {
        "skills": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "skillEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "name",
        "description",
        "lifecycle",
        "risk",
        "digest",
        "fileCount",
        "bytes"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/skillName"
        },
        "description": {
          "type": "string"
        },
        "lifecycle": {
          "const": "active"
        },
        "risk": {
          "enum": [
            "instruction-only",
            "resource-backed"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "surface",
        "skill",
        "path",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowKey",
        "kind",
        "status",
        "skill",
        "evidenceCount",
        "signals",
        "lastObservedAt"
      ],
      "properties": {
        "workflowKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "create",
            "improve",
            "reconcile",
            "retire",
            "observe"
          ]
        },
        "status": {
          "enum": [
            "eligible",
            "insufficient-evidence"
          ]
        },
        "skill": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "signals": {
          "$ref": "#/$defs/signalCounts"
        },
        "lastObservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "signalCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeated-task",
        "missing-workflow",
        "user-correction",
        "trigger-miss",
        "trigger-collision",
        "tool-failure",
        "stale-guidance",
        "successful-run",
        "unused-skill",
        "superseded-skill"
      ],
      "properties": {
        "repeated-task": {
          "type": "integer",
          "minimum": 0
        },
        "missing-workflow": {
          "type": "integer",
          "minimum": 0
        },
        "user-correction": {
          "type": "integer",
          "minimum": 0
        },
        "trigger-miss": {
          "type": "integer",
          "minimum": 0
        },
        "trigger-collision": {
          "type": "integer",
          "minimum": 0
        },
        "tool-failure": {
          "type": "integer",
          "minimum": 0
        },
        "stale-guidance": {
          "type": "integer",
          "minimum": 0
        },
        "successful-run": {
          "type": "integer",
          "minimum": 0
        },
        "unused-skill": {
          "type": "integer",
          "minimum": 0
        },
        "superseded-skill": {
          "type": "integer",
          "minimum": 0
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "syncSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "packageVersion",
        "catalogDigest"
      ],
      "properties": {
        "packageName": {
          "const": "@mnstry/atelier"
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "catalogDigest": {
          "$ref": "#/$defs/digest"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "syncTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "lockPath"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "lockPath": {
          "$ref": "#/$defs/relativePath"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "syncAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "expectedDigest",
        "currentDigest",
        "nextDigest",
        "quarantinePath"
      ],
      "properties": {
        "type": {
          "enum": [
            "add",
            "adopt",
            "unchanged",
            "update",
            "quarantine"
          ]
        },
        "name": {
          "$ref": "#/$defs/skillName"
        },
        "expectedDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "currentDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "nextDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "quarantinePath": {
          "anyOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "lockedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/skillName"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "reportAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetry",
        "egress",
        "promptCapture",
        "sourceMutation",
        "runtimeMutation",
        "applyEndpoint"
      ],
      "properties": {
        "telemetry": {
          "const": false
        },
        "egress": {
          "const": false
        },
        "promptCapture": {
          "const": false
        },
        "sourceMutation": {
          "const": false
        },
        "runtimeMutation": {
          "const": false
        },
        "applyEndpoint": {
          "type": "null"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "syncAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetry",
        "egress",
        "sourceMutation",
        "targetMutation",
        "destructiveDelete"
      ],
      "properties": {
        "telemetry": {
          "const": false
        },
        "egress": {
          "const": false
        },
        "sourceMutation": {
          "const": false
        },
        "targetMutation": {
          "const": "content-bound-confirmed"
        },
        "destructiveDelete": {
          "const": false
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "skillName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
