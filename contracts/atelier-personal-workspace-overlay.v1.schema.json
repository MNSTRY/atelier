            "required": [
              "repoId",
              "nodeId"
            ],
            "properties": {
              "repoId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "nodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\s]+$"
              },
              "ext": {
                "type": "object",
                "maxProperties": 0,
                "description": "Reserved for a later admitted extension. Non-empty extensions refuse in this version; they grant no authority."
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 8192
          },
