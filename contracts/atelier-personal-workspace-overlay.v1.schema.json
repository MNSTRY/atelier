            "type": "string",
            "maxLength": 8192
          },
          "tags": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(\\S|\\S[\\s\\S]*\\S)$"
            },
