{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-coauthor.v1.schema.json",
  "$comment": "contract revision 1.0.0",
  "title": "Private coauthor configuration and draft",
  "oneOf": [
    {
      "$ref": "#/$defs/config"
    },
    {
      "$ref": "#/$defs/draft"
    }
  ],
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "ext": {
                    "type": "object",
                    "description": "Reserved inert metadata; does not grant authority."
                  }
                },
                "required": [
                  "ref",
                  "digest"
                ]
              },
              "ext": {
                "type": "object",
                "description": "Reserved inert metadata; does not grant authority."
              }
            },
            "required": [
              "id",
              "source"
            ]
          }
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "ext": {
          "type": "object",
          "description": "Reserved inert metadata; does not grant authority."
        }
      },
      "required": [
        "id",
        "fields"
      ]
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "atelier-coauthor-draft@v1"
        },
        "status": {
          "const": "draft"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "fieldId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "sourceRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "valueDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ext": {
              "type": "object",
              "description": "Reserved inert metadata; does not grant authority."
            }
          },
          "required": [
            "sessionId",
            "requestId",
            "fieldId",
            "sourceRef",
            "sourceDigest",
            "valueDigest"
          ]
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "ext": {
          "type": "object",
          "description": "Reserved inert metadata; does not grant authority."
        }
      },
      "required": [
        "schema",
        "status",
        "text",
        "receipt"
      ]
    }
  }
}
