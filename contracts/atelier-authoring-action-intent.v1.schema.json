{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-authoring-action-intent.v1.schema.json",
  "$comment": "contract revision 1.0.0",
  "title": "atelier-authoring-action-intent@v1",
  "description": "A proposal-only envelope for an action requested from a consumer-owned authoring adapter. Validation of this envelope never grants publication, editorial-gate, or MNSTRY runtime mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "projectionId",
    "tenantRef",
    "subjectRef",
    "kind",
    "status",
    "requestedAt",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "atelier-authoring-action-intent@v1"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "$ref": "#/$defs/stableRef"
    },
    "projectionId": {
      "$ref": "#/$defs/stableRef"
    },
    "tenantRef": {
      "$ref": "#/$defs/stableRef"
    },
    "subjectRef": {
      "$ref": "#/$defs/stableRef"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "status": {
      "const": "proposed"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "publicationMutation",
        "editorialGateMutation",
        "runtimeMutation"
      ],
      "properties": {
        "decision": {
          "const": "consumer-adapter"
        },
        "publicationMutation": {
          "const": false
        },
        "editorialGateMutation": {
          "const": false
        },
        "runtimeMutation": {
          "const": false
        },
        "ext": {
          "type": "object",
          "description": "Reserved extension container."
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Reserved extension container. The consumer adapter owns and validates any private action payload placed here."
    }
  },
  "$defs": {
    "stableRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
