      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "atelier-harness-handoff@v1"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
