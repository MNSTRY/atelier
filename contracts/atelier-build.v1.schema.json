                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "kind": {
                    "enum": [
                      "source",
                      "review",
                      "ci",
                      "runtime",
                      "integration",
                      "delivery"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "ext": {
                    "type": "object",
                    "maxProperties": 0
