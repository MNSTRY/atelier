    {
      "$ref": "#/$defs/objective"
    },
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/attempt"
    },
    {
      "$ref": "#/$defs/progress"
    },
    {
      "$ref": "#/$defs/gate"
    },
    {
      "$ref": "#/$defs/decision"
    },
    {
      "$ref": "#/$defs/delivery"
    }
