        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "assurance": {
          "const": "caller-reported"
        },
        "authority": {
          "const": "none"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "ext": {
          "type": "object",
          "maxProperties": 0
        }
      },
      "required": [
        "schema",
        "source",
        "target",
        "audience",
        "payload",
        "payloadDigest",
        "assurance",
        "authority"
      ]
