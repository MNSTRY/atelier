{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-obsidian-service-state.v1.schema.json",
  "title": "Obsidian maintenance service state",
  "$comment": "contract revision 1.0.0; private state shape; workspace service identity, literal loopback, port, runtime ID, PID, executable, health and consent record. Machine-local values live here and never in a portable shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspaceId",
    "serviceName",
    "host",
    "port",
    "runtimeId",
    "pid",
    "executable",
    "stateLocation",
    "health",
    "consent"
  ],
  "properties": {
    "schema": {
      "const": "atelier-obsidian-service-state/v1"
    },
    "workspaceId": {
      "$ref": "#/$defs/identifier"
    },
    "serviceName": {
      "$ref": "#/$defs/identifier"
    },
    "host": {
      "enum": [
        "127.0.0.1",
        "::1"
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "runtimeId": {
      "$ref": "#/$defs/identifier"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "stateLocation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "starting",
            "healthy",
            "degraded",
            "stopped"
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantedAt",
        "actor",
        "coverage"
      ],
      "properties": {
        "grantedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "actor": {
          "$ref": "#/$defs/identifier"
        },
        "coverage": {
          "enum": [
            "service",
            "service-and-startup"
          ]
        },
        "ext": {
          "type": "object"
        }
      }
    },
    "ext": {
      "type": "object"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
