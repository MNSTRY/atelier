        "releaseDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "host": {
