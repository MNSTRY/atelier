{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-template-profile.v1.schema.json",
  "$comment": "Additive data-only profile. Stage results prove structure and exact content identity, never authenticated policy, host execution, publication or acceptance.",
  "$ref": "#/$defs/definition",
  "$defs": {
    "TemplateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "TemplateRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "BindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "BindingRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "SourceRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "PolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "PolicyRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "AuthorityDecisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "AuthorityDecisionRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "ReleaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "ReleaseRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "ProjectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "ProjectionRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "RuntimeProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "RuntimeProfileRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "SchemaRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "CapabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "CapabilityRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "PayloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "PayloadRef"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "version",
        "purpose",
        "inputs",
        "limitations",
        "semanticRoles",
        "surfaceRoles",
        "runtimeProfileRef",
        "carriers",
        "extensions",
        "optionalDecisions",
        "compatibility",
        "definitionLicense"
      ],
      "properties": {
        "schema": {
          "const": "atelier-template-profile@v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
          "maxLength": 64
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "semanticRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "primitive",
              "required",
              "cardinality"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "primitive": {
                "enum": [
                  "Resource",
                  "Relation",
                  "Facet",
                  "Asset",
                  "Collection",
                  "Sequence",
                  "Occurrence",
                  "Offer",
                  "ActionDescriptor"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "cardinality": {
                "enum": [
                  "one",
                  "many"
                ]
              }
            }
          }
        },
        "surfaceRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "primitive",
              "semanticRoleRefs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "primitive": {
                "enum": [
                  "Shell",
                  "Region",
                  "CollectionView",
                  "ResourceCard",
                  "DetailView",
                  "GraphExplorer",
                  "FilterControl",
                  "OfferView",
                  "StatusView",
                  "RefusalView",
                  "ReceiptView"
                ]
              },
              "semanticRoleRefs": {
                "type": "array",
                "minItems": 0,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
                  "maxLength": 128
                }
              }
            }
          }
        },
        "runtimeProfileRef": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/RuntimeProfileRef"
            }
          ]
        },
        "carriers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required"
            ],
            "properties": {
              "id": {
                "enum": [
                  "web",
                  "desktop",
                  "chat",
                  "documents",
                  "email",
                  "mcp",
                  "llms-txt",
                  "koine"
                ]
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "required",
              "schemaRef",
              "payloadRef"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$",
                "maxLength": 128
              },
              "required": {
                "type": "boolean"
              },
              "schemaRef": {
                "$ref": "#/$defs/SchemaRef"
              },
              "payloadRef": {
                "$ref": "#/$defs/PayloadRef"
              }
            }
          }
        },
        "optionalDecisions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "contract",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "contract": {
                "const": "atelier-decision-request@v1"
              },
              "required": {
                "const": false
              }
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "atelierVersions",
            "packRefs"
          ],
          "properties": {
            "atelierVersions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            },
            "packRefs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version",
                  "digest"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
                    "maxLength": 128
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^v[0-9]+$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "definitionLicense": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "version",
        "templateRef",
        "projectRef",
        "roles"
      ],
      "properties": {
        "schema": {
          "const": "atelier-template-binding@v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
          "maxLength": 64
        },
        "templateRef": {
          "$ref": "#/$defs/TemplateRef"
        },
        "projectRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleRef",
              "sourceRefs"
            ],
            "properties": {
              "roleRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/SourceRef"
                }
              }
            }
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "version",
        "templateRef",
        "bindingRef",
        "carrier",
        "sourceRefs",
        "policyRefs",
        "authorityDecisionRefs",
        "payloadRef",
        "capabilityRef"
      ],
      "properties": {
        "schema": {
          "const": "atelier-template-projection@v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
          "maxLength": 64
        },
        "templateRef": {
          "$ref": "#/$defs/TemplateRef"
        },
        "bindingRef": {
          "$ref": "#/$defs/BindingRef"
        },
        "carrier": {
          "enum": [
            "web",
            "desktop",
            "chat",
            "documents",
            "email",
            "mcp",
            "llms-txt",
            "koine"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "policyRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PolicyRef"
          }
        },
        "authorityDecisionRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/AuthorityDecisionRef"
          }
        },
        "payloadRef": {
          "$ref": "#/$defs/PayloadRef"
        },
        "capabilityRef": {
          "$ref": "#/$defs/CapabilityRef"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "version",
        "templateRef",
        "bindingRef",
        "projectionRefs"
      ],
      "properties": {
        "schema": {
          "const": "atelier-template-release@v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
          "maxLength": 64
        },
        "templateRef": {
          "$ref": "#/$defs/TemplateRef"
        },
        "bindingRef": {
          "$ref": "#/$defs/BindingRef"
        },
        "projectionRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ProjectionRef"
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "templateRef",
        "carrier",
        "atelierVersion",
        "packRefs",
        "semanticPrimitives",
        "surfacePrimitives",
        "runtimeProfileRef",
        "optionalDecisions"
      ],
      "properties": {
        "schema": {
          "const": "atelier-template-host@v1"
        },
        "templateRef": {
          "$ref": "#/$defs/TemplateRef"
        },
        "carrier": {
          "enum": [
            "web",
            "desktop",
            "chat",
            "documents",
            "email",
            "mcp",
            "llms-txt",
            "koine"
          ]
        },
        "atelierVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "packRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "pattern": "^v[0-9]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        },
        "semanticPrimitives": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Resource",
              "Relation",
              "Facet",
              "Asset",
              "Collection",
              "Sequence",
              "Occurrence",
              "Offer",
              "ActionDescriptor"
            ]
          }
        },
        "surfacePrimitives": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Shell",
              "Region",
              "CollectionView",
              "ResourceCard",
              "DetailView",
              "GraphExplorer",
              "FilterControl",
              "OfferView",
              "StatusView",
              "RefusalView",
              "ReceiptView"
            ]
          }
        },
        "runtimeProfileRef": {
          "anyOf": [
            {
              "type": "null"
