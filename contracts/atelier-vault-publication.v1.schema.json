{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/schemas/atelier/atelier-vault-publication.v1.schema.json",
  "title": "Private vault publication request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "expectedRevision",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "atelier-vault-publication/v1"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "base64"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "base64": {
            "type": "string",
            "maxLength": 4194304,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "ext": {
            "type": "object"
          }
        }
      }
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "ext": {
      "type": "object"
    }
  },
  "$comment": "contract revision 1.0.0; explicit host-bound private artifact publication."
}
