          ]
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "ext": {
          "type": "object",
          "maxProperties": 0
        }
      },
      "required": [
        "schema",
        "kind",
        "id",
        "repository",
        "revision",
        "scope",
        "observedAt",
        "expiresAt",
        "source",
        "body"
      ]
    }
  }
}
