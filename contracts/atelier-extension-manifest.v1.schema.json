{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "mnstry.extension-manifest/v1"
    },
    "extensionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "releaseVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "releaseDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol": {
      "const": "mnstry.extension/v1"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdkMajor": {
          "const": 1
        },
        "rootContracts": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "web",
              "native"
            ]
          }
        }
      },
      "required": [
        "sdkMajor",
        "rootContracts",
        "hosts"
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "postgres-sql",
            "drizzle-db-first",
            "drizzle-code-first",
            "prisma-7-postgres",
            "prisma-8-postgres-experimental",
            "convex-native"
          ]
        },
        "bundleDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "schemaDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "profile",
        "bundleDigest",
        "schemaDigest"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "effect": {
            "enum": [
              "read",
              "write"
            ]
          },
          "scope": {
            "enum": [
              "member",
              "tenant"
            ]
          },
          "inputSchemaRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^schemas/[a-zA-Z0-9._-]+\\.json$"
          },
          "outputSchemaRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^schemas/[a-zA-Z0-9._-]+\\.json$"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          }
        },
        "required": [
          "id",
          "effect",
          "scope",
          "inputSchemaRef",
          "outputSchemaRef",
          "timeoutMs"
        ]
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lookupActionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        }
      },
      "required": [
        "lookupActionId"
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rootReads": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "rootWrites": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "egress": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "rootReads",
        "rootWrites",
        "egress"
      ]
    },
    "surfaces": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "compositionDigest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "actionIds": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "required": [
          "id",
          "compositionDigest",
          "actionIds"
        ]
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "retention": {
          "const": "until-user-delete"
        },
        "exportVersion": {
          "const": 1
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "readableSchemaVersions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "classes",
        "retention",
        "exportVersion",
        "schemaVersion",
        "readableSchemaVersions"
      ]
    }
  },
  "required": [
    "schema",
    "extensionId",
    "releaseVersion",
    "releaseDigest",
    "protocol",
    "compatibility",
    "deployment",
    "actions",
    "permissions",
    "surfaces",
    "data"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnstry.ai/contracts/atelier-extension-manifest.v1.schema.json"
}
